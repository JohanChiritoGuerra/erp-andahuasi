@page "/login"
@model ErpAndahuasi.Pages.Auth.LoginModel
@{
  Layout = "Layouts/_BlankLayout";
  ViewData["Title"] = "Iniciar sesión";
}

<main class="erp-login" style="background: linear-gradient(135deg, #111827 0%, #172554 52%, @Model.Tenant.PrimaryColor 160%);">
  <video class="erp-login__video" autoplay loop muted playsinline>
    <source src="~/videos/login-background.mp4" type="video/mp4" />
  </video>
  <div class="erp-login__overlay"></div>

  <section class="erp-login__card">
    <header class="erp-login__brand">
      <img class="erp-login__logo" src="~/img/branding/logo-andahuasi-oscuro.svg" alt="@Model.Tenant.Nombre" />
      <p class="erp-login__lugar">km. 41.5 Carretera Huaura - Sayán</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
      <div class="erp-login__alert">
        <div class="alert @(Model.SessionExpired ? "alert-warning" : "alert-danger")">@Model.ErrorMessage</div>
      </div>
    }

    <form method="post" class="erp-login__form" id="erp-login-form" novalidate autocomplete="off">
      <div>
        <label class="erp-login__label" asp-for="Usuario">Usuario</label>
        <div class="erp-login__control">
          <i class="ri ri-user-3-line erp-login__glyph" aria-hidden="true"></i>
          <input asp-for="Usuario" class="form-control erp-login__input" placeholder="Ingrese su usuario" autocomplete="username" maxlength="20" autofocus />
        </div>
      </div>
      <div>
        <label class="erp-login__label" asp-for="Password">Contraseña</label>
        <div class="erp-login__control">
          <i class="ri ri-lock-2-line erp-login__glyph" aria-hidden="true"></i>
          <input asp-for="Password" type="password" class="form-control erp-login__input" placeholder="••••••••" autocomplete="current-password" />
          <button type="button" class="erp-login__eye" id="erp-login-toggle-password" aria-label="Mostrar contraseña">
            <i class="ri ri-eye-off-line"></i>
          </button>
        </div>
      </div>
      <div class="form-check">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label">Recordarme</label>
      </div>
      <button type="submit" class="erp-login__submit" id="erp-login-submit">
        <i class="ri-login-box-line" aria-hidden="true"></i>
        <span>Iniciar sesión</span>
      </button>
    </form>
  </section>
</main>

@section PageScripts {
<script>
  (function () {
    const toggle = document.getElementById('erp-login-toggle-password');
    const form = document.getElementById('erp-login-form');
    const submit = document.getElementById('erp-login-submit');
    toggle?.addEventListener('click', () => {
      const input = document.getElementById('Password');
      const icon = toggle.querySelector('i');
      if (!input || !icon) return;
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('ri-eye-off-line', 'ri-eye-line');
        toggle.setAttribute('aria-label', 'Ocultar contraseña');
      } else {
        input.type = 'password';
        icon.classList.replace('ri-eye-line', 'ri-eye-off-line');
        toggle.setAttribute('aria-label', 'Mostrar contraseña');
      }
    });
    form?.addEventListener('submit', () => {
      submit.disabled = true;
    });
  })();
</script>
}
