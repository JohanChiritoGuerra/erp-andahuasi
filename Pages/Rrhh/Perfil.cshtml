@page "/rrhh/perfil"
@model ErpAndahuasi.Pages.Rrhh.PerfilModel
@{
  ViewData["Title"] = "Mi perfil";
  var foto = ErpSession.Current.PhotoUrl;
}

<h4 class="mb-1">Mi perfil</h4>
<p class="text-muted mb-6">Datos del trabajador autenticado.</p>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
  <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="card">
  <div class="card-body">
    <div class="text-center mb-6">
      @if (!string.IsNullOrWhiteSpace(foto))
      {
        <img src="@foto" alt="@ErpSession.Current.DisplayName" class="rounded mb-3" style="width:96px;height:128px;object-fit:cover;" />
      }
      <h5 class="mb-1">@(Model.Perfil?.Nombres ?? ErpSession.Current.DisplayName)</h5>
      @if (!string.IsNullOrWhiteSpace(Model.Perfil?.Cargo))
      {
        <p class="text-muted mb-1">@Model.Perfil.Cargo</p>
      }
      @if (!string.IsNullOrWhiteSpace(Model.Perfil?.TrabDNI))
      {
        <span class="badge bg-label-primary">DNI: @Model.Perfil.TrabDNI</span>
      }
    </div>
    <div class="row g-4">
      <div class="col-md-6">
        <label class="form-label">Inicio de contrato</label>
        <input class="form-control" readonly value="@(Model.Perfil?.ContLabFecInicio?.ToString("dd/MM/yyyy") ?? "-")" />
      </div>
      <div class="col-md-6">
        <label class="form-label">Fin de contrato</label>
        <input class="form-control" readonly value="@(Model.Perfil?.ContLabFecFin?.ToString("dd/MM/yyyy") ?? "-")" />
      </div>
      <div class="col-md-6">
        <label class="form-label">Correo electrónico</label>
        <input class="form-control" readonly value="@Model.Perfil?.TrabCorreoElec" />
      </div>
      <div class="col-md-6">
        <label class="form-label">Teléfono / celular</label>
        <input class="form-control" readonly value="@Model.Perfil?.TrabTelef" />
      </div>
      <div class="col-12">
        <label class="form-label">Dirección</label>
        <textarea class="form-control" rows="2" readonly>@Model.Perfil?.TrabDireccion</textarea>
      </div>
    </div>
  </div>
</div>
