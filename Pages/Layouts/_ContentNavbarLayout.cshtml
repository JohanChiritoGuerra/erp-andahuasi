@using ErpAndahuasi.Api
@inject RrhhApi Rrhh
@await Html.PartialAsync("Layouts/Sections/_Variables")
@{
  TempData.Keep();
  Layout = "Layouts/_CommonMasterLayout";
  TempData["menuHorizontal"] = false;
  ViewData["skipTemplateMain"] = true;

  var user = ErpSession.Current;
  var displayName = string.IsNullOrWhiteSpace(user.DisplayName) ? "Mi perfil" : user.DisplayName;
  var cargo = "";
  if (ErpSession.IsAuthenticated && !string.IsNullOrWhiteSpace(user.TrabId))
  {
    const string cargoKey = "ErpCargo";
    if (Context.Items[cargoKey] is string cached)
    {
      cargo = cached;
    }
    else
    {
      try
      {
        var perfil = await Rrhh.GetPerfilAsync();
        cargo = perfil.BaseResponse.Success ? perfil.PerfilTrabajador?.Cargo ?? "" : "";
      }
      catch
      {
        cargo = "";
      }

      Context.Items[cargoKey] = cargo;
    }
  }
}

@section VendorStyles {
  @RenderSection("VendorStyles", required: false)
}

@section PageStyles {
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/andahuasi-tokens.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/andahuasi-shell.css" asp-append-version="true" />
  <script>
    (function (h) {
      if (h.dataset.sidebar === 'expanded' || h.dataset.sidebar === 'rail') return;
      var match = document.cookie.match(/(?:^|; )sidebar=(expanded|rail)/);
      h.dataset.sidebar = match ? match[1] : (innerWidth >= 1280 ? 'expanded' : 'rail');
    })(document.documentElement);
  </script>
  @RenderSection("PageStyles", required: false)
}

@section VendorScripts {
  @RenderSection("VendorScripts", required: false)
}

@section PageScripts {
  <script src="~/js/shell.js" asp-append-version="true"></script>
  <script src="~/js/fecha.js" asp-append-version="true"></script>
  <script>
    (() => {
      const cuerpo = document.getElementById('pop-notif-body');
      if (!cuerpo) return;
      const puntos = document.querySelectorAll('[data-notif-dot]');
      const token = () => document.querySelector('#erp-antiforgery input')?.value || '';
      const hace = iso => {
        const min = Math.round((Date.now() - new Date(iso).getTime()) / 60000);
        if (min < 1) return 'ahora';
        if (min < 60) return 'hace ' + min + ' min';
        const horas = Math.round(min / 60);
        if (horas < 24) return 'hace ' + horas + ' h';
        return new Date(iso).toLocaleDateString('es-PE');
      };
      const pintar = data => {
        const items = data?.items || [];
        const noLeidas = data?.noLeidas || 0;
        puntos.forEach(p => { p.hidden = noLeidas === 0; });
        cuerpo.replaceChildren();
        if (!items.length) {
          const vacio = document.createElement('div');
          vacio.className = 'dt-empty';
          vacio.textContent = 'No tienes notificaciones.';
          cuerpo.append(vacio);
          return;
        }
        for (const item of items) {
          const a = document.createElement('a');
          a.className = 'notif' + (item.leida ? '' : ' unread');
          a.href = '/tramites/' + item.tramiteId;
          const mark = document.createElement('span');
          mark.className = 'mark';
          const texto = document.createElement('span');
          const titulo = document.createElement('b');
          titulo.textContent = item.titulo || '';
          const sub = document.createElement('small');
          sub.textContent = (item.mensaje || '') + ' · ' + hace(item.fec);
          texto.append(titulo, sub);
          a.append(mark, texto);
          cuerpo.append(a);
        }
      };
      const cargar = () => fetch('/tramites?handler=Avisos').then(r => r.ok ? r.json() : null).then(pintar).catch(() => {});
      document.getElementById('notif-leidas')?.addEventListener('click', () => {
        fetch('/tramites?handler=AvisosLeer', { method: 'POST', headers: { 'RequestVerificationToken': token() } })
          .then(r => r.ok ? r.json() : null).then(pintar).catch(() => {});
      });
      cargar();
    })();
  </script>
  @RenderSection("PageScripts", required: false)
}

<div class="app">
  <div class="scrim" data-drawer-close></div>

  <aside class="sidebar" aria-label="Navegación principal">
    <div class="sb-brand">
      <button type="button" class="icon-btn" data-sidebar-toggle aria-label="Contraer o expandir menú">
        <i class="ri ri-layout-left-line"></i>
      </button>
      <a href="/" aria-label="Andahuasi, inicio">
        <img class="shell-logo shell-logo--light" src="~/img/branding/logo-andahuasi-claro.svg" alt="Andahuasi" />
        <img class="shell-logo shell-logo--dark" src="~/img/branding/logo-andahuasi-oscuro.svg" alt="" />
      </a>
    </div>

    <div class="sb-search">
      <label class="search">
        <i class="ri ri-search-line"></i>
        <input type="search" placeholder="Buscar accesos..." data-nav-search aria-label="Buscar accesos" />
        <button type="button" class="search-clear" data-search-clear aria-label="Borrar búsqueda" hidden><i class="ri ri-close-line"></i></button>
      </label>
      <button type="button" class="icon-btn bordered" data-nav-expand-all aria-label="Expandir o contraer todo">
        <i class="ri ri-expand-up-down-line"></i>
      </button>
      <button type="button" class="icon-btn bordered sb-search-rail" data-flyout-all aria-label="Buscar accesos">
        <i class="ri ri-search-line"></i>
      </button>
    </div>

    <nav class="sb-nav">
      @await Html.PartialAsync("Layouts/Sections/Menu/_ShellNav")
    </nav>

    <div class="sb-footer">
      <button type="button" class="avatar" data-popover="pop-cuenta" data-placement="right-end" aria-label="Cuenta" aria-expanded="false">
        @if (!string.IsNullOrWhiteSpace(user.PhotoUrl))
        {
          <img src="@user.PhotoUrl" alt="" />
        }
        else
        {
          <i class="ri ri-user-line" style="font-size:17px"></i>
        }
        <span class="online"></span>
      </button>
      <span class="sb-user"><b>@displayName</b><small>@cargo</small></span>
      <button type="button" class="icon-btn has-dot" data-popover="pop-notif" data-placement="right-end" aria-label="Notificaciones" aria-expanded="false">
        <i class="ri ri-notification-3-line"></i>
        <span class="dot" data-notif-dot hidden></span>
      </button>
    </div>
  </aside>

  <div class="shell-main-col">
    <header class="mobile-header">
      <button type="button" class="icon-btn bordered" data-drawer-open aria-label="Abrir menú">
        <i class="ri ri-menu-line" style="font-size:18px"></i>
      </button>
      <a href="/" aria-label="Andahuasi, inicio">
        <img class="shell-logo shell-logo--light" src="~/img/branding/logo-andahuasi-claro.svg" alt="Andahuasi" />
        <img class="shell-logo shell-logo--dark" src="~/img/branding/logo-andahuasi-oscuro.svg" alt="" />
      </a>
      <button type="button" class="icon-btn has-dot" data-popover="pop-notif" data-placement="bottom-end" aria-label="Notificaciones" aria-expanded="false">
        <i class="ri ri-notification-3-line"></i>
        <span class="dot" data-notif-dot hidden></span>
      </button>
      <button type="button" class="avatar" data-popover="pop-cuenta" data-placement="bottom-end" aria-label="Cuenta" aria-expanded="false">
        @if (!string.IsNullOrWhiteSpace(user.PhotoUrl))
        {
          <img src="@user.PhotoUrl" alt="" />
        }
        else
        {
          <i class="ri ri-user-line" style="font-size:17px"></i>
        }
        <span class="online"></span>
      </button>
    </header>

    <main class="shell-main@(ViewData["shellFill"] is true ? " shell-main--fill" : "")">
      @RenderBody()
      <form id="erp-antiforgery" class="d-none">@Html.AntiForgeryToken()</form>
    </main>
  </div>

  <div class="popover" id="pop-cuenta" role="menu" hidden>
    <a class="menu-item" href="/rrhh/perfil">Ver mi perfil</a>
    <button type="button" class="menu-item" data-theme-set="light">Modo claro</button>
    <button type="button" class="menu-item" data-theme-set="dark">Modo oscuro</button>
    <div class="menu-sep"></div>
    <a class="shell-logout" href="/logout">Cerrar sesión <i class="ri ri-logout-box-r-line"></i></a>
  </div>

  <div class="popover wide" id="pop-notif" hidden>
    <div class="pop-head">
      <span class="pop-title">Notificaciones</span>
    </div>
    <div class="pop-body" id="pop-notif-body">
      <div class="dt-empty">No tienes notificaciones.</div>
    </div>
    <div class="pop-foot">
      <button type="button" id="notif-leidas">Marcar leídas</button>
      <a href="/tramites">Ver bandeja</a>
    </div>
  </div>

  <div class="flyout" id="nav-flyout" hidden>
    <div class="flyout-head">
      <span class="flyout-title"></span>
      <div class="flyout-tools">
        <label class="search sm">
          <i class="ri ri-search-line"></i>
          <input type="search" data-flyout-search aria-label="Buscar" />
          <button type="button" class="search-clear" data-search-clear aria-label="Borrar búsqueda" hidden><i class="ri ri-close-line"></i></button>
        </label>
        <button type="button" class="icon-btn bordered" style="width:30px;height:30px" data-flyout-expand-all aria-label="Expandir o contraer todo">
          <i class="ri ri-expand-up-down-line"></i>
        </button>
      </div>
    </div>
    <div class="flyout-body"></div>
  </div>
</div>
