@page "/presupuesto/consumo/nuevo"
@model ErpAndahuasi.Pages.Presupuesto.Consumo.NuevoModel
@{
  ViewData["Title"] = "Presupuesto de consumo";
}
@section PageStyles {
  <link rel="stylesheet" href="~/css/andahuasi-pages.css" asp-append-version="true" />
  <style>
    #ppto-nuevo .ppto-marca { display: flex; align-items: center; gap: 12px; }
    #ppto-nuevo .ppto-anio { margin-left: 8px; font-variant-numeric: tabular-nums; }
    #ppto-nuevo .ppto-alta { max-width: 480px; display: flex; flex-direction: column; gap: 8px; margin-top: 12px; }
    #ppto-nuevo .ppto-centro { display: flex; align-items: center; gap: 8px; min-height: 20px; }
    #ppto-nuevo .ppto-centro strong { font-size: 13px; font-weight: 600; }
    #ppto-nuevo .ppto-items { flex: 1; min-height: 0; display: flex; flex-direction: column; margin-top: 16px; }
    #ppto-nuevo .ppto-scroll { flex: 1; min-height: 0; overflow: auto; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--panel); }
    #ppto-nuevo table { border-collapse: separate; border-spacing: 0; font-size: 12px; font-variant-numeric: tabular-nums; }
    #ppto-nuevo th, #ppto-nuevo td { padding: 6px 8px; border-bottom: 1px solid var(--border); white-space: nowrap; background: var(--panel); }
    #ppto-nuevo th { position: sticky; top: 0; z-index: 2; background: var(--field); font-size: 11px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--faint); }
    #ppto-nuevo td.fija, #ppto-nuevo th.fija { position: sticky; left: 0; z-index: 1; }
    #ppto-nuevo th.fija { z-index: 3; }
    #ppto-nuevo tr.pie td { font-weight: 600; background: var(--field); }
    #ppto-nuevo .num { text-align: right; }
    #ppto-nuevo dialog.modal { width: min(640px, calc(100% - 32px)); }
    #ppto-nuevo dialog.modal.ancho { width: min(880px, calc(100% - 32px)); }
    #ppto-nuevo .modal-body { display: flex; flex-direction: column; gap: 8px; }
    #ppto-nuevo .data-table { --dt-cols: 132px minmax(0, 1fr); min-height: 220px; }
    #ppto-nuevo button.dt-row { width: 100%; border: 0; border-bottom: 1px solid var(--border); background: transparent; text-align: left; font: inherit; cursor: pointer; }
    #ppto-nuevo .meses { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    #ppto-nuevo .mes { display: flex; align-items: center; gap: 8px; }
    #ppto-nuevo .mes input[type="number"] { width: 72px; }
  </style>
}

<div class="erp-ds erp-ds--fill" id="ppto-nuevo" data-anio="@Model.Anio">
  <div class="page-head">
    <div class="ppto-marca">
      <span class="stat-icon info" title="Consumo"><i class="ri ri-archive-line"></i></span>
      <div>
        <h1 class="page-title">Presupuesto de consumo <span class="ppto-anio">@Model.Anio</span></h1>
        <p class="page-sub">Materiales · anual</p>
      </div>
    </div>
    <div class="page-actions">
      <a class="btn" href="/presupuesto/consumo"><i class="ri ri-arrow-left-line"></i>Volver</a>
      <button type="button" class="btn btn-primary" id="ppto-grabar" disabled>Grabar</button>
    </div>
  </div>

  <div class="ppto-alta">
    <label class="field">
      <span class="field-label">Centro de costos</span>
      <input class="input" id="ppto-codigo" maxlength="15" autocomplete="off" placeholder="Escribe el centro de costos, presiona Enter o haz doble clic" />
      <span class="field-help">Se puede cambiar hasta grabar.</span>
    </label>
    <div class="ppto-centro" id="ppto-centro" hidden>
      <strong id="ppto-centro-nombre"></strong>
      <span class="pill" id="ppto-centro-estado"></span>
    </div>
    <p class="field-error" id="ppto-aviso" hidden></p>
  </div>

  <div class="ppto-items">
    <div class="page-actions" style="margin-bottom:8px">
      <div class="segmented" style="width:220px" role="group" aria-label="Unidad de los meses">
        <input type="radio" name="ppto-modo" id="ppto-modo-cant" value="cantidad" checked />
        <label for="ppto-modo-cant">Cantidad</label>
        <input type="radio" name="ppto-modo" id="ppto-modo-monto" value="monto" />
        <label for="ppto-modo-monto">Monto</label>
      </div>
      <button type="button" class="btn" id="ppto-agregar" disabled><i class="ri ri-add-line"></i>Agregar</button>
    </div>
    <div class="ppto-scroll">
      <table>
        <thead>
          <tr>
            <th class="fija">Código</th><th>Descripción</th><th class="num">Precio</th>
            <th class="num">Ene</th><th class="num">Feb</th><th class="num">Mar</th><th class="num">Abr</th>
            <th class="num">May</th><th class="num">Jun</th><th class="num">Jul</th><th class="num">Ago</th>
            <th class="num">Set</th><th class="num">Oct</th><th class="num">Nov</th><th class="num">Dic</th>
            <th class="num">Total cant.</th><th class="num">Total S/</th><th></th>
          </tr>
        </thead>
        <tbody id="ppto-cuerpo"></tbody>
      </table>
    </div>
  </div>

  <dialog class="modal" id="ppto-dlg-busca" aria-labelledby="ppto-dlg-busca-t">
    <div class="modal-head">
      <i class="ri ri-search-line"></i>
      <span class="modal-title" id="ppto-dlg-busca-t">Centro de costos</span>
      <button type="button" class="icon-btn" data-cerrar aria-label="Cerrar"><i class="ri ri-close-line"></i></button>
    </div>
    <div class="modal-body">
      <label class="search">
        <i class="ri ri-search-line"></i>
        <input id="ppto-filtro" type="search" placeholder="Descripción" autocomplete="off" />
      </label>
      <p class="field-help">Enter filtra. * deja texto en medio: camion*24.</p>
      <div class="data-table">
        <div class="dt-head"><span>Código</span><span>Nombre</span></div>
        <div class="dt-body" id="ppto-lista"><div class="empty">Escribe la descripción y presiona Enter.</div></div>
      </div>
      <p class="field-help" id="ppto-busca-estado"></p>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn" data-cerrar>Cancelar</button>
    </div>
  </dialog>

  <dialog class="modal ancho" id="ppto-dlg-item" aria-labelledby="ppto-dlg-item-t">
    <div class="modal-head">
      <i class="ri ri-archive-line"></i>
      <span class="modal-title" id="ppto-dlg-item-t">Material</span>
      <button type="button" class="icon-btn" data-cerrar aria-label="Cerrar"><i class="ri ri-close-line"></i></button>
    </div>
    <div class="modal-body">
      <label class="field" id="ppto-buscar-wrap">
        <span class="field-label">Material</span>
        <input class="input" id="ppto-buscar" placeholder="Código o descripción" autocomplete="off" />
      </label>
      <div id="ppto-buscar-lista"></div>
      <p id="ppto-item-meta" class="hint-text"></p>
      <div class="meses" id="ppto-meses" hidden></div>
      <p class="field-error" id="ppto-item-error" hidden></p>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn" data-cerrar>Cancelar</button>
      <button type="button" class="btn btn-primary" id="ppto-item-ok">Guardar</button>
    </div>
  </dialog>
</div>

@section PageScripts {
<script>
(() => {
  const raiz = document.getElementById('ppto-nuevo');
  const anio = Number(raiz.dataset.anio);
  const codigoEl = document.getElementById('ppto-codigo');
  const aviso = document.getElementById('ppto-aviso');
  const dlgBusca = document.getElementById('ppto-dlg-busca');
  const dlgItem = document.getElementById('ppto-dlg-item');
  const meses = ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Set','Oct','Nov','Dic'];
  const soles = n => 'S/ ' + Number(n || 0).toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const num = n => Number(n || 0).toLocaleString('es-PE', { maximumFractionDigits: 3 });
  const token = () => document.querySelector('#erp-antiforgery input')?.value || '';
  const modo = () => document.querySelector('input[name="ppto-modo"]:checked').value;
  let periodoAbierto = false;
  let centro = null;
  let lineas = [];
  let precioActual = null;
  let ocupado = false;

  const avisar = texto => { aviso.hidden = !texto; aviso.textContent = texto || ''; };
  const listo = () => !!(centro && centro.activo && centro.periodoAbierto && !centro.correlativoExistente);

  function botones() {
    document.getElementById('ppto-agregar').disabled = ocupado || !listo();
    document.getElementById('ppto-grabar').disabled = ocupado || !listo() || lineas.length === 0;
    codigoEl.disabled = ocupado || !periodoAbierto;
  }

  function td(texto, clase) {
    const celda = document.createElement('td');
    if (clase) celda.className = clase;
    celda.textContent = texto;
    return celda;
  }

  function montos(linea) {
    return linea.cantidades.map((cantidad, i) => Math.round(cantidad * (linea.precios[i] || 0) * 100) / 100);
  }

  function pintar() {
    const cuerpo = document.getElementById('ppto-cuerpo');
    cuerpo.replaceChildren();
    const verMonto = modo() === 'monto';
    const totales = Array(12).fill(0);
    let total = 0;
    if (!lineas.length) {
      const tr = document.createElement('tr');
      const celda = document.createElement('td');
      celda.colSpan = 18;
      celda.textContent = listo() ? 'Agrega los materiales de este centro.' : 'Indica el centro de costos para cargar materiales.';
      tr.appendChild(celda);
      cuerpo.appendChild(tr);
      botones();
      return;
    }
    for (const linea of lineas) {
      const importes = montos(linea);
      const tr = document.createElement('tr');
      const desc = document.createElement('td');
      desc.textContent = linea.descripcion;
      tr.append(td(linea.codigo, 'fija'), desc, td(linea.precioVaria ? 'Varía' : soles(linea.precio), 'num'));
      importes.forEach((monto, i) => {
        totales[i] += monto;
        tr.appendChild(td(verMonto ? soles(monto) : num(linea.cantidades[i]), 'num'));
      });
      const cant = linea.cantidades.reduce((s, n) => s + n, 0);
      const suma = importes.reduce((s, n) => s + n, 0);
      total += suma;
      tr.append(td(num(cant), 'num'), td(soles(suma), 'num'));
      const acc = document.createElement('td');
      const editar = document.createElement('button');
      editar.type = 'button';
      editar.className = 'icon-btn';
      editar.setAttribute('aria-label', 'Modificar');
      editar.innerHTML = '<i class="ri ri-pencil-line"></i>';
      editar.addEventListener('click', () => abrirItem(linea));
      const eliminar = document.createElement('button');
      eliminar.type = 'button';
      eliminar.className = 'icon-btn';
      eliminar.setAttribute('aria-label', 'Quitar');
      eliminar.innerHTML = '<i class="ri ri-delete-bin-line"></i>';
      eliminar.addEventListener('click', () => { lineas = lineas.filter(x => x.codigo !== linea.codigo); pintar(); });
      acc.append(editar, eliminar);
      tr.appendChild(acc);
      cuerpo.appendChild(tr);
    }
    const pie = document.createElement('tr');
    pie.className = 'pie';
    pie.append(td(''), td('Total'), td(''));
    totales.forEach(monto => pie.appendChild(td(soles(monto), 'num')));
    pie.append(td(''), td(soles(total), 'num'), td(''));
    cuerpo.appendChild(pie);
    botones();
  }

  function mostrarCentro(data) {
    document.getElementById('ppto-centro').hidden = !data;
    if (!data) return;
    document.getElementById('ppto-centro-nombre').textContent = data.descripcion || '';
    const estado = document.getElementById('ppto-centro-estado');
    estado.textContent = data.activo ? 'Activo' : 'Inactivo';
    estado.className = 'pill ' + (data.activo ? 'pill-success' : 'pill-danger');
  }

  async function consultar(codigo) {
    if (ocupado || codigoEl.disabled) return;
    if (codigo.length !== 15) {
      centro = null;
      mostrarCentro(null);
      avisar('Ingrese correctamente el código del centro de costo.');
      pintar();
      return;
    }
    avisar('');
    const res = await fetch(`?handler=Centro&anio=${anio}&codigo=${encodeURIComponent(codigo)}`);
    const data = await res.json();
    if (!data.baseResponse?.success) {
      centro = null;
      mostrarCentro(null);
      avisar(data.baseResponse?.message || 'No se encontró el centro de costo.');
      pintar();
      return;
    }
    centro = data;
    mostrarCentro(data);
    if (!data.activo || !data.periodoAbierto) {
      avisar(data.baseResponse?.message || '');
      pintar();
      return;
    }
    if (data.correlativoExistente && lineas.length === 0) {
      location.href = `/presupuesto/consumo/${anio}/${data.correlativoExistente}`;
      return;
    }
    if (data.correlativoExistente) {
      avisar(`Ya existe el presupuesto de este centro. El centro de uno guardado no se cambia.`);
      const enlace = document.createElement('a');
      enlace.href = `/presupuesto/consumo/${anio}/${data.correlativoExistente}`;
      enlace.textContent = ' Abrir';
      aviso.appendChild(enlace);
    }
    pintar();
  }

  codigoEl.addEventListener('keydown', ev => {
    if (ev.key !== 'Enter') return;
    ev.preventDefault();
    consultar(codigoEl.value.trim());
  });
  codigoEl.addEventListener('input', () => {
    codigoEl.value = codigoEl.value.replace(/\D/g, '').slice(0, 15);
    if (centro && codigoEl.value !== centro.codigo) {
      centro = null;
      mostrarCentro(null);
      pintar();
    }
  });
  codigoEl.addEventListener('dblclick', () => {
    if (codigoEl.disabled) return;
    dlgBusca.showModal();
    document.getElementById('ppto-filtro').focus();
  });

  async function buscarCentro() {
    const texto = document.getElementById('ppto-filtro').value.trim();
    const lista = document.getElementById('ppto-lista');
    const estado = document.getElementById('ppto-busca-estado');
    lista.replaceChildren();
    if (texto.replace(/[*\s]/g, '').length < 2) {
      estado.textContent = 'Escribe al menos 2 caracteres.';
      return;
    }
    estado.textContent = 'Buscando…';
    const res = await fetch(`?handler=Centros&anio=${anio}&texto=${encodeURIComponent(texto)}`);
    const data = await res.json();
    lista.replaceChildren();
    if (!data.baseResponse?.success) {
      estado.textContent = data.baseResponse?.message || 'No se pudo buscar.';
      return;
    }
    const items = data.items || [];
    estado.textContent = data.baseResponse.message || '';
    if (!items.length) {
      const vacio = document.createElement('div');
      vacio.className = 'empty';
      vacio.textContent = 'Ningún centro activo coincide.';
      lista.appendChild(vacio);
      return;
    }
    for (const item of items) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'dt-row';
      for (const textoFila of [item.codigo, item.descripcion]) {
        const span = document.createElement('span');
        span.textContent = textoFila || '';
        btn.appendChild(span);
      }
      btn.addEventListener('click', () => {
        dlgBusca.close();
        codigoEl.value = item.codigo;
        consultar(item.codigo);
      });
      lista.appendChild(btn);
    }
  }

  document.getElementById('ppto-filtro').addEventListener('keydown', ev => {
    if (ev.key !== 'Enter') return;
    ev.preventDefault();
    buscarCentro();
  });
  dlgBusca.querySelectorAll('[data-cerrar]').forEach(el => el.addEventListener('click', () => dlgBusca.close()));

  function precios() { return precioActual?.precios || Array(12).fill(0); }
  function mostrarMeta() {
    const meta = document.getElementById('ppto-item-meta');
    if (!precioActual?.codigo) { meta.textContent = ''; return; }
    const precio = precioActual.precioVaria ? 'el precio proyectado cambia por mes' : `precio proyectado ${soles(precioActual.precio)}`;
    meta.textContent = `${precioActual.codigo} · ${precioActual.descripcion} · ${precioActual.unidad || ''} · ${precio}`;
  }
  function armarMeses(cantidades) {
    const caja = document.getElementById('ppto-meses');
    caja.replaceChildren();
    caja.hidden = false;
    precios().forEach((precio, i) => {
      const wrap = document.createElement('div');
      wrap.className = 'mes';
      const sw = document.createElement('label');
      sw.className = 'switch';
      const input = document.createElement('input');
      input.type = 'checkbox';
      const ui = document.createElement('span');
      ui.className = 'switch-ui';
      sw.append(input, ui);
      const cant = document.createElement('input');
      cant.className = 'input';
      cant.type = 'number';
      cant.min = '0';
      cant.step = '0.001';
      cant.disabled = true;
      cant.setAttribute('aria-label', `Cantidad ${meses[i]}`);
      if (cantidades && cantidades[i] > 0) {
        input.checked = true;
        cant.disabled = false;
        cant.value = String(cantidades[i]);
      }
      input.addEventListener('change', () => {
        cant.disabled = !input.checked;
        if (!input.checked) cant.value = '';
        else cant.focus();
      });
      const nombre = document.createElement('span');
      nombre.textContent = precioActual.precioVaria ? `${meses[i]} · ${soles(precio)}` : meses[i];
      wrap.append(sw, cant, nombre);
      caja.appendChild(wrap);
    });
  }
  function abrirItem(linea) {
    document.getElementById('ppto-item-error').hidden = true;
    document.getElementById('ppto-buscar-wrap').hidden = !!linea;
    document.getElementById('ppto-buscar-lista').replaceChildren();
    precioActual = linea ? { ...linea, baseResponse: { success: true } } : null;
    document.getElementById('ppto-buscar').value = '';
    mostrarMeta();
    if (linea) armarMeses(linea.cantidades);
    else document.getElementById('ppto-meses').hidden = true;
    dlgItem.showModal();
  }
  document.getElementById('ppto-agregar').addEventListener('click', () => abrirItem(null));
  dlgItem.querySelectorAll('[data-cerrar]').forEach(el => el.addEventListener('click', () => dlgItem.close()));

  let timer;
  document.getElementById('ppto-buscar').addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(async () => {
      const texto = document.getElementById('ppto-buscar').value.trim();
      const lista = document.getElementById('ppto-buscar-lista');
      lista.replaceChildren();
      if (texto.length < 2) return;
      const res = await fetch(`?handler=Items&anio=${anio}&texto=${encodeURIComponent(texto)}`);
      const data = await res.json();
      for (const item of data.items || []) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'menu-item';
        btn.textContent = `${item.codigo} · ${item.descripcion}`;
        btn.addEventListener('click', async () => {
          lista.replaceChildren();
          const precio = await (await fetch(`?handler=Precio&anio=${anio}&codigo=${item.codigo}`)).json();
          precioActual = precio.baseResponse?.success ? precio : null;
          mostrarMeta();
          const error = document.getElementById('ppto-item-error');
          if (!precio.baseResponse?.success) {
            error.hidden = false;
            error.textContent = precio.baseResponse?.message || 'El material no se puede presupuestar.';
            document.getElementById('ppto-meses').hidden = true;
            return;
          }
          error.hidden = true;
          armarMeses(lineas.find(x => x.codigo === precio.codigo)?.cantidades);
        });
        lista.appendChild(btn);
      }
    }, 250);
  });

  document.getElementById('ppto-item-ok').addEventListener('click', () => {
    const error = document.getElementById('ppto-item-error');
    error.hidden = true;
    if (!precioActual?.codigo) {
      error.hidden = false;
      error.textContent = 'Elige un material.';
      return;
    }
    const interruptores = Array.from(document.querySelectorAll('#ppto-meses input[type="checkbox"]'));
    const cantidades = interruptores.map(sw => {
      const cant = sw.parentElement.parentElement.querySelector('input[type="number"]');
      return sw.checked ? Number(cant.value) : 0;
    });
    if (cantidades.some((valor, i) => interruptores[i].checked && !(valor > 0))) {
      error.hidden = false;
      error.textContent = 'Un mes encendido necesita una cantidad mayor que cero.';
      return;
    }
    if (!cantidades.some(valor => valor > 0)) {
      error.hidden = false;
      error.textContent = 'Enciende al menos un mes.';
      return;
    }
    const linea = {
      codigo: precioActual.codigo,
      descripcion: precioActual.descripcion,
      unidad: precioActual.unidad,
      precio: precioActual.precio,
      precioVaria: precioActual.precioVaria,
      precios: precios(),
      cantidades
    };
    const idx = lineas.findIndex(x => x.codigo === linea.codigo);
    if (idx >= 0) lineas[idx] = linea;
    else lineas.push(linea);
    dlgItem.close();
    pintar();
  });

  document.getElementById('ppto-grabar').addEventListener('click', async () => {
    if (!listo() || !lineas.length) return;
    ocupado = true;
    botones();
    avisar('');
    const creado = await (await fetch('?handler=Crear', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
      body: JSON.stringify({ anio, descripcion: (centro.descripcion || '').slice(0, 50), centroCosto: centro.codigo })
    })).json();
    if (!creado.baseResponse?.success) {
      ocupado = false;
      botones();
      avisar(creado.baseResponse?.message || 'No se pudo grabar.');
      return;
    }
    for (const linea of lineas) {
      const guardado = await (await fetch('?handler=Guardar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
        body: JSON.stringify({ anio, correlativo: creado.correlativo, codigo: linea.codigo, cantidades: linea.cantidades })
      })).json();
      if (!guardado.baseResponse?.success) break;
    }
    location.href = `/presupuesto/consumo/${anio}/${creado.correlativo}`;
  });

  document.querySelectorAll('input[name="ppto-modo"]').forEach(el => el.addEventListener('change', pintar));

  async function periodo() {
    const res = await fetch(`?handler=Periodo&anio=${anio}`);
    const data = await res.json();
    periodoAbierto = !!data.abierto;
    if (!periodoAbierto)
      avisar(data.baseResponse?.message || 'El periodo de registro presupuestal está cerrado o no está autorizado. Consulte con el jefe presupuestal.');
    pintar();
  }

  periodo();
})();
</script>
}
