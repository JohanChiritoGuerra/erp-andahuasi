@page "/paltos/campos-campanias/{campoPaltoId:long}"
@model ErpAndahuasi.Pages.Paltos.CamposCampanias.DetalleModel
@{
  ViewData["Title"] = Model.Campo?.NombreActual ?? "Campo";
  ViewData["shellFill"] = true;
}
@section PageStyles {
  <link rel="stylesheet" href="~/css/andahuasi-pages.css" asp-append-version="true" />
}
@section VendorScripts {
  <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
  <script src="~/js/erp.js"></script>
}

<div class="erp-ds erp-ds--fill cc-detail" id="campos-campanias" data-mode="detalle" data-id="@Model.CampoPaltoId">
  <div class="page-head">
    <div>
      <a href="/paltos/campos-campanias" class="btn btn-sm" id="cc-back" style="margin-bottom:10px"><i class="ri ri-arrow-left-line"></i>Volver a la lista</a>
      <h1 class="page-title" id="cc-title">@(Model.Campo?.NombreActual ?? "Campo")</h1>
      <p class="page-sub" id="cc-sub">@(Model.Campo is null ? "" : $"{Model.Campo.CodigoCampo} · {Model.Campo.AreaActualHa:N2} ha")</p>
    </div>
  </div>
  @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
  {
    <div class="note note-danger">@Model.ErrorMessage</div>
  }
  <div class="panel" id="campo-panel">
    <div class="panel-body"><div class="empty">Cargando ficha…</div></div>
  </div>

  <dialog class="modal modal-form" id="dlg-plan" aria-labelledby="dlg-plan-t">
    <div class="modal-head">
      <i class="ri ri-calendar-line"></i>
      <span class="modal-title" id="dlg-plan-t">Nueva campaña en planificación</span>
      <button type="button" class="icon-btn" data-modal-close aria-label="Cerrar"><i class="ri ri-close-line"></i></button>
    </div>
    <div class="modal-body">
      <div class="note">La herencia crea una copia independiente. No se copian consumos ni cierres.</div>
      <div class="field-grid">
        <div class="field">
          <label for="cc-plan-ini">Inicio</label>
          <input class="input" id="cc-plan-ini" type="date" />
        </div>
        <div class="field">
          <label for="cc-plan-fin">Fin</label>
          <input class="input" id="cc-plan-fin" type="date" />
        </div>
        <div class="field">
          <label for="cc-plan-cod">Código sugerido</label>
          <input class="input" id="cc-plan-cod" type="text" />
        </div>
        <div class="field">
          <label for="cc-plan-nom">Nombre</label>
          <input class="input" id="cc-plan-nom" type="text" />
        </div>
        <div class="field field--full">
          <span class="field-label">Heredar presupuesto</span>
          <div class="dropdown" id="cc-origen-dd">
            <input type="hidden" id="cc-plan-origen" value="" />
            <button type="button" class="dropdown-btn" data-dropdown-btn><span data-dropdown-label>Crear sin heredar presupuesto</span><i class="ri ri-arrow-down-s-line"></i></button>
            <div class="dropdown-menu" id="cc-origen-menu" hidden></div>
          </div>
        </div>
      </div>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn" data-modal-close>Cancelar</button>
      <button type="button" class="btn btn-primary" id="cc-plan-save">Crear planificación</button>
    </div>
  </dialog>
</div>

@section PageScripts {
  <script src="~/js/campos-campanias.js" asp-append-version="true"></script>
}
