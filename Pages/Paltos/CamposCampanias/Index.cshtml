@page "/paltos/campos-campanias"
@model ErpAndahuasi.Pages.Paltos.CamposCampanias.IndexModel
@{
  ViewData["Title"] = "Campos y campañas";
  ViewData["shellFill"] = true;
}
@section PageStyles {
  <link rel="stylesheet" href="~/css/andahuasi-pages.css" asp-append-version="true" />
}
@section VendorScripts {
  <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
  <script src="~/js/erp.js"></script>
}

<div class="erp-ds erp-ds--fill" id="campos-campanias" data-mode="lista">
  <div class="tpl-list-panel cc-layout">
    <div class="page-head">
      <div>
        <h1 class="page-title">Campos y campañas</h1>
        <p class="page-sub">Existencia actual e historial de la gestión del cultivo de paltos</p>
      </div>
      <div class="page-actions">
        <button type="button" class="btn" id="cc-btn-hist"><i class="ri ri-history-line"></i>Reconstruir historial</button>
        <button type="button" class="btn btn-primary" id="cc-btn-add"><i class="ri ri-add-line"></i>Incorporar campo</button>
      </div>
    </div>

    <div class="tpl-grid">
      <section class="tpl-col">
        <div class="segmented" id="cc-estado">
          <input type="radio" name="cc-estado" id="cc-act" value="activos" checked />
          <label for="cc-act" data-tab-label="activos">Activos</label>
          <input type="radio" name="cc-estado" id="cc-ina" value="inactivos" />
          <label for="cc-ina" data-tab-label="inactivos">Inactivos</label>
        </div>
        <div class="toolbar">
          <label class="search on-panel">
            <i class="ri ri-search-line"></i>
            <input type="search" id="cc-q" placeholder="Buscar por código o nombre" aria-label="Buscar campos" />
            <button type="button" class="search-clear" data-search-clear aria-label="Borrar búsqueda" hidden><i class="ri ri-close-line"></i></button>
          </label>
        </div>
        <div class="data-table" style="--dt-cols:minmax(0,1fr) 72px minmax(120px,1fr)">
          <div class="dt-head"><span>Campo</span><span>Área</span><span>Campaña</span></div>
          <div class="dt-body" id="cc-rows"></div>
          <div class="dt-foot"><span id="cc-count">Cargando…</span></div>
        </div>
      </section>
      <aside class="panel" id="campo-panel">
        <div class="panel-body"><div class="empty">Seleccione un campo para ver su ficha y el historial.</div></div>
      </aside>
    </div>
  </div>

  <dialog class="modal modal-form" id="dlg-add" aria-labelledby="dlg-add-t">
    <div class="modal-head">
      <i class="ri ri-landscape-line"></i>
      <span class="modal-title" id="dlg-add-t">Incorporar campo a Paltos</span>
      <button type="button" class="icon-btn" data-modal-close aria-label="Cerrar"><i class="ri ri-close-line"></i></button>
    </div>
    <div class="modal-body">
      <div class="field">
        <label for="cc-cat-q">Campo de cultivo</label>
        <div class="search">
          <i class="ri ri-search-line"></i>
          <input type="search" id="cc-cat-q" placeholder="Código o nombre" autocomplete="off" aria-autocomplete="list" aria-controls="cc-cat-list" />
          <button type="button" class="search-clear" data-search-clear aria-label="Borrar búsqueda" hidden><i class="ri ri-close-line"></i></button>
        </div>
        <input type="hidden" id="cc-cat" value="" />
        <div class="cc-cat" id="cc-cat-list" role="listbox" hidden></div>
        <p class="field-help" id="cc-cat-hint">Escriba el código o el nombre para elegir el campo.</p>
      </div>
      <div class="field">
        <label for="cc-add-area">Área actual ha</label>
        <input class="input" id="cc-add-area" type="number" min="0" step="0.01" />
      </div>
      <div class="field">
        <label for="cc-add-var">Variedad</label>
        <input class="input" id="cc-add-var" type="text" />
      </div>
      <div class="field">
        <label for="cc-add-pat">Patrón</label>
        <input class="input" id="cc-add-pat" type="text" />
      </div>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn" data-modal-close>Cancelar</button>
      <button type="button" class="btn btn-primary" id="cc-add-save" disabled>Incorporar</button>
    </div>
  </dialog>

  <dialog class="modal modal-form" id="dlg-hist" aria-labelledby="dlg-hist-t">
    <div class="modal-head">
      <i class="ri ri-history-line"></i>
      <span class="modal-title" id="dlg-hist-t">Reconstruir campañas desde almacén</span>
      <button type="button" class="icon-btn" data-modal-close aria-label="Cerrar"><i class="ri ri-close-line"></i></button>
    </div>
    <div class="modal-body">
      <div class="note note-warning">Las campañas se identificarán como reconstruidas. El área y el presupuesto serán referenciales; la cobertura muestra cuántos productos tienen configuración técnica.</div>
      <div class="cc-hist" id="cc-hist-list"></div>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn" data-modal-close>Cancelar</button>
      <button type="button" class="btn btn-primary" id="cc-hist-save" disabled>Confirmar reconstrucción</button>
    </div>
  </dialog>

  <dialog class="modal modal-form" id="dlg-plan" aria-labelledby="dlg-plan-t">
    <div class="modal-head">
      <i class="ri ri-calendar-line"></i>
      <span class="modal-title" id="dlg-plan-t">Nueva campaña en planificación</span>
      <button type="button" class="icon-btn" data-modal-close aria-label="Cerrar"><i class="ri ri-close-line"></i></button>
    </div>
    <div class="modal-body">
      <div class="note">La herencia crea una copia independiente. No se copian consumos ni cierres.</div>
      <div class="field-grid">
        <div class="field">
          <label for="cc-plan-ini">Inicio</label>
          <input class="input" id="cc-plan-ini" type="date" />
        </div>
        <div class="field">
          <label for="cc-plan-fin">Fin</label>
          <input class="input" id="cc-plan-fin" type="date" />
        </div>
        <div class="field">
          <label for="cc-plan-cod">Código sugerido</label>
          <input class="input" id="cc-plan-cod" type="text" />
        </div>
        <div class="field">
          <label for="cc-plan-nom">Nombre</label>
          <input class="input" id="cc-plan-nom" type="text" />
        </div>
        <div class="field field--full">
          <span class="field-label">Heredar presupuesto</span>
          <div class="dropdown" id="cc-origen-dd">
            <input type="hidden" id="cc-plan-origen" value="" />
            <button type="button" class="dropdown-btn" data-dropdown-btn><span data-dropdown-label>Crear sin heredar presupuesto</span><i class="ri ri-arrow-down-s-line"></i></button>
            <div class="dropdown-menu" id="cc-origen-menu" hidden></div>
          </div>
        </div>
      </div>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn" data-modal-close>Cancelar</button>
      <button type="button" class="btn btn-primary" id="cc-plan-save">Crear planificación</button>
    </div>
  </dialog>
</div>

@section PageScripts {
  <script src="~/js/campos-campanias.js" asp-append-version="true"></script>
}
