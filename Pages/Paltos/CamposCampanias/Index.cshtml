@page "/paltos/campos-campanias"
@model ErpAndahuasi.Pages.Paltos.CamposCampanias.IndexModel
@{
  ViewData["Title"] = "Campos y campañas";
}
@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.dist.css" />
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.dist.css" />
}
@section VendorScripts {
  <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.dist.js"></script>
  <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
  <script src="~/js/erp.js"></script>
}
<div class="d-flex justify-content-between mb-4">
  <div>
    <h4 class="mb-1">Campos y campañas</h4>
    <p class="text-muted mb-0">Existencia de campos de palto y su historial.</p>
  </div>
  <div>
    <button class="btn btn-outline-secondary me-2" id="btnPreview">Reconstrucción</button>
    <button class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#drawer" id="btnNuevo">Incorporar campo</button>
  </div>
</div>
<div class="card">
  <div class="table-responsive">
    <table class="table" id="tabla">
      <thead><tr><th>Código</th><th>Nombre</th><th>Área</th><th>Campaña activa</th><th>Estado</th><th></th></tr></thead>
    </table>
  </div>
</div>
<div class="offcanvas offcanvas-end" id="drawer" tabindex="-1">
  <div class="offcanvas-header border-bottom"><h5 class="offcanvas-title">Campo</h5><button class="btn-close" data-bs-dismiss="offcanvas"></button></div>
  <div class="offcanvas-body">
    <input type="hidden" id="campoPaltoId" />
    <div class="mb-3"><label class="form-label">Código</label><input class="form-control" id="codigoCampo" list="catalogoLista" /></div>
    <datalist id="catalogoLista"></datalist>
    <div class="mb-3"><label class="form-label">Área (ha)</label><input type="number" step="0.01" class="form-control" id="areaActualHa" /></div>
    <div class="mb-3"><label class="form-label">Variedad</label><input class="form-control" id="variedad" /></div>
    <div class="mb-3"><label class="form-label">Patrón</label><input class="form-control" id="patron" /></div>
    <div class="mb-3"><label class="form-label">Observaciones</label><textarea class="form-control" id="observaciones"></textarea></div>
    <div class="form-check form-switch mb-4"><input class="form-check-input" type="checkbox" id="activo" checked /><label class="form-check-label" for="activo">Activo</label></div>
    <button class="btn btn-primary w-100" id="btnGuardar">Guardar</button>
  </div>
</div>
@section PageScripts {
<script>
  let table;
  const drawer = new bootstrap.Offcanvas('#drawer');
  function load() { erp.get('?handler=Lista').then(r => table.clear().rows.add(r?.data || []).draw()); }
  $(function () {
    table = $('#tabla').DataTable({
      data: [],
      columns: [
        { data: 'codigoCampo' }, { data: 'nombreActual' },
        { data: 'areaActualHa', render: v => Number(v||0).toFixed(2) },
        { data: null, render: r => r.campaniaActiva ? `${r.campaniaActiva.codigo} ${r.campaniaActiva.nombre}` : '-' },
        { data: 'activo', render: v => v ? '<span class="badge bg-label-success">Activo</span>' : '<span class="badge bg-label-secondary">Inactivo</span>' },
        { data: null, orderable: false, render: r => `<a class="btn btn-sm btn-outline-primary" href="/paltos/campos-campanias/${r.campoPaltoId}">Detalle</a>
          <button class="btn btn-sm btn-text-secondary edit"><i class="ri ri-pencil-line"></i></button>` }
      ]
    });
    load();
    erp.get('?handler=Catalogo').then(r => $('#catalogoLista').html((r?.data||[]).map(c => `<option value="${c.codigoCampo}">${c.nombreCampo}</option>`).join('')));
    $('#btnNuevo').on('click', () => $('#campoPaltoId,#codigoCampo,#areaActualHa,#variedad,#patron,#observaciones').val(''));
    $('#tabla').on('click', '.edit', function () {
      const r = table.row($(this).closest('tr')).data();
      $('#campoPaltoId').val(r.campoPaltoId); $('#codigoCampo').val(r.codigoCampo); $('#areaActualHa').val(r.areaActualHa);
      $('#variedad').val(r.variedad); $('#patron').val(r.patron); $('#observaciones').val(r.observaciones); $('#activo').prop('checked', r.activo); drawer.show();
    });
    $('#btnGuardar').on('click', async () => {
      const res = await erp.post('?handler=Guardar', {
        campoPaltoId: $('#campoPaltoId').val() ? Number($('#campoPaltoId').val()) : null,
        codigoCampo: $('#codigoCampo').val(),
        areaActualHa: $('#areaActualHa').val() ? Number($('#areaActualHa').val()) : null,
        variedad: $('#variedad').val(), patron: $('#patron').val(), observaciones: $('#observaciones').val(),
        activo: $('#activo').is(':checked')
      });
      erp.toast(res.success ? 'success' : 'error', res.message || 'Guardado');
      if (res.success) { drawer.hide(); load(); }
    });
    $('#btnPreview').on('click', async () => {
      const res = await erp.get('?handler=Preview');
      const rows = (res?.data||[]).map(c => `${c.codigoCampo} ${c.campania} (${c.salidas} salidas)`).join('\n') || 'Sin datos';
      if (!await erp.confirm('Reconstruir histórico', rows)) return;
      const codes = (res?.data||[]).filter(c => !c.yaReconstruida).map(c => c.codigoCampo);
      const rec = await erp.post('?handler=Reconstruir', { codigosCampo: codes });
      erp.toast(rec.success ? 'success' : 'error', rec.message || 'Reconstrucción enviada'); load();
    });
  });
</script>
}
