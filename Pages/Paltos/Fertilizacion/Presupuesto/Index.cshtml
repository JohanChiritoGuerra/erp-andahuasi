@page "/paltos/fertilizacion/presupuesto"
@model ErpAndahuasi.Pages.Paltos.Fertilizacion.Presupuesto.IndexModel
@{
  ViewData["Title"] = "Presupuesto de fertilización";
}
@section PageStyles {
  <link rel="stylesheet" href="~/css/andahuasi-pages.css" asp-append-version="true" />
}
@section VendorScripts {
  <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
  <script src="~/js/erp.js"></script>
  <script src="~/js/fert-presupuesto.js" asp-append-version="true"></script>
}

<div class="erp-ds" id="fert-presupuesto">
  <div class="fp">
    <div class="page-head">
      <div>
        <h1 class="page-title">Presupuesto de fertilización</h1>
        <p class="page-sub">Objetivos mensuales en kg de elemento por hectárea, por campo y campaña</p>
      </div>
      <div class="page-actions">
        <a class="btn" id="fp-control" href="/paltos/fertilizacion/control"><i class="ri ri-line-chart-line"></i>Ver control</a>
      </div>
    </div>

    <div class="card fp-pick">
      <div class="step-head"><span class="step-num">1</span>Seleccionar presupuesto</div>
      <div class="fp-tools">
        <label class="switch">
          <input type="checkbox" id="fp-activos" checked role="switch" />
          <span class="switch-ui" aria-hidden="true"></span>
          <span class="switch-text">Activos</span>
        </label>
        <div class="field">
          <span class="field-label">Campo</span>
          <div class="dropdown" id="fp-campo-dd">
            <input type="hidden" id="fp-campo" value="" />
            <button type="button" class="dropdown-btn" data-dropdown-btn><span data-dropdown-label>Seleccionar campo</span><i class="ri ri-arrow-down-s-line"></i></button>
            <div class="dropdown-menu" id="fp-campo-menu" hidden></div>
          </div>
        </div>
        <div class="field fp-camp">
          <div class="dropdown" id="fp-camp-dd">
            <input type="hidden" id="fp-camp" value="" />
            <button type="button" class="dropdown-btn" data-dropdown-btn><span data-dropdown-label>Seleccionar campaña</span><i class="ri ri-arrow-down-s-line"></i></button>
            <div class="dropdown-menu" id="fp-camp-menu" hidden></div>
          </div>
        </div>
        <div class="fp-facts" id="fp-facts" hidden></div>
        <div class="fp-pills" id="fp-pills"></div>
      </div>
    </div>

    <div id="fp-body"><div class="empty">Cargando campañas…</div></div>
  </div>
</div>
