@page "/paltos/fertilizacion/presupuesto"
@model ErpAndahuasi.Pages.Paltos.Fertilizacion.Presupuesto.IndexModel
@{
  ViewData["Title"] = "Presupuesto de fertilización";
}
@section VendorStyles {
  <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.dist.css" />
  <link rel="stylesheet" href="~/css/paltos-presupuesto.css" />
}
@section VendorScripts {
  <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
  <script src="~/js/erp.js"></script>
  <script src="~/js/erp/paltos-presupuesto.js"></script>
}
<h4 class="mb-1">Presupuesto</h4>
<p class="text-muted mb-4">Matriz mensual de objetivos por elemento (kg/ha).</p>
<div class="card mb-4">
  <div class="card-body row g-3 align-items-end">
    <div class="col-md-6">
      <label class="form-label">Campaña</label>
      <select class="form-select" id="campoCampaniaId"></select>
    </div>
    <div class="col-md-3">
      <label class="form-label">Rendimiento objetivo (t/ha)</label>
      <input type="number" step="0.01" class="form-control" id="rendimiento" />
    </div>
    <div class="col-md-3">
      <button class="btn btn-primary" id="btnGuardar">Guardar presupuesto</button>
    </div>
    <div class="col-12">
      <label class="form-label">Observaciones</label>
      <textarea class="form-control" id="observaciones"></textarea>
    </div>
  </div>
</div>
<div class="card">
  <div class="card-body table-responsive" id="matrizWrap">
    <p class="text-muted mb-0">Seleccione una campaña.</p>
  </div>
</div>
