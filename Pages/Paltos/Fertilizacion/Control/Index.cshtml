@page "/paltos/fertilizacion/control"
@model ErpAndahuasi.Pages.Paltos.Fertilizacion.Control.IndexModel
@{
  ViewData["Title"] = "Control de fertilización";
}
@section PageStyles {
  <link rel="stylesheet" href="~/css/andahuasi-pages.css" asp-append-version="true" />
}
@section VendorScripts {
  <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
  <script src="~/js/erp.js"></script>
  <script src="~/js/fert-control.js" asp-append-version="true"></script>
}

<div class="erp-ds" id="fert-control">
  <div class="fp">
    <div class="page-head">
      <div>
        <h1 class="page-title">Control de fertilización</h1>
        <p class="page-sub">Presupuesto frente a las salidas de almacén, por campo, campaña y mes</p>
      </div>
      <div class="page-actions">
        <a class="btn" id="fc-presupuesto" href="/paltos/fertilizacion/presupuesto"><i class="ri ri-file-chart-line"></i>Ver presupuesto</a>
      </div>
    </div>

    <div class="card fp-pick">
      <div class="step-head"><span class="step-num">1</span>Seleccionar control</div>
      <p class="hint-text">Primero el campo y luego una campaña que ya tenga presupuesto.</p>
      <div class="fp-tools">
        <label class="switch">
          <input type="checkbox" id="fc-activos" checked role="switch" />
          <span class="switch-ui" aria-hidden="true"></span>
          <span class="switch-text">Activos</span>
        </label>
        <div class="field">
          <span class="field-label">Campo</span>
          <div class="dropdown" id="fc-campo-dd">
            <input type="hidden" id="fc-campo" value="" />
            <button type="button" class="dropdown-btn" data-dropdown-btn><span data-dropdown-label>Seleccionar campo</span><i class="ri ri-arrow-down-s-line"></i></button>
            <div class="dropdown-menu" id="fc-campo-menu" hidden></div>
          </div>
        </div>
        <div class="field">
          <span class="field-label">Campaña</span>
          <div class="dropdown" id="fc-camp-dd">
            <input type="hidden" id="fc-camp" value="" />
            <button type="button" class="dropdown-btn" data-dropdown-btn><span data-dropdown-label>Seleccionar campaña</span><i class="ri ri-arrow-down-s-line"></i></button>
            <div class="dropdown-menu" id="fc-camp-menu" hidden></div>
          </div>
        </div>
        <div class="fc-facts" id="fc-facts" hidden></div>
      </div>
    </div>

    <div id="fc-body"><div class="empty">Cargando campañas…</div></div>
  </div>

  <dialog class="modal modal-form" id="dlg-salidas" aria-labelledby="dlg-salidas-t">
    <div class="modal-head">
      <i class="ri ri-file-list-3-line"></i>
      <span class="modal-title" id="dlg-salidas-t">Detalle de salidas</span>
      <button type="button" class="icon-btn" data-modal-close aria-label="Cerrar"><i class="ri ri-close-line"></i></button>
    </div>
    <div class="modal-body" id="fc-salidas-body"></div>
    <div class="modal-foot">
      <button type="button" class="btn" data-modal-close>Cerrar</button>
    </div>
  </dialog>

  <dialog class="modal modal-form" id="dlg-reabrir" aria-labelledby="dlg-reabrir-t">
    <div class="modal-head">
      <i class="ri ri-lock-unlock-line"></i>
      <span class="modal-title" id="dlg-reabrir-t">Reabrir mes</span>
      <button type="button" class="icon-btn" data-modal-close aria-label="Cerrar"><i class="ri ri-close-line"></i></button>
    </div>
    <div class="modal-body">
      <p class="hint-text">El cierre anterior queda auditado como reabierto. Indique el motivo.</p>
      <div class="field">
        <label for="fc-motivo">Motivo</label>
        <textarea class="input input--area" id="fc-motivo" maxlength="400"></textarea>
      </div>
    </div>
    <div class="modal-foot">
      <button type="button" class="btn" data-modal-close>Cancelar</button>
      <button type="button" class="btn btn-primary" id="fc-reabrir-save">Reabrir mes</button>
    </div>
  </dialog>
</div>
