@page "/paltos/fertilizacion/configuracion-items/{codigo}"
@model ErpAndahuasi.Pages.Paltos.Fertilizacion.ConfiguracionItems.ItemModel
@{
  ViewData["Title"] = Model.Item?.NombreItem ?? "Configurar ítem";
  ViewData["shellFill"] = true;
  var item = Model.Item;
  var comun = string.Equals(item?.DestinoReporte, "CONSUMO", StringComparison.OrdinalIgnoreCase);
  var liquido = string.Equals(item?.FormaFisica, "LIQUIDO", StringComparison.OrdinalIgnoreCase);
  var elementosFijos = new[] { "N", "P", "K", "Ca", "Mg", "S", "B", "Zn", "Fe", "Mn", "Cu" };
}
@section PageStyles {
  <link rel="stylesheet" href="~/css/andahuasi-pages.css" asp-append-version="true" />
}
@section VendorScripts {
  <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
  <script src="~/js/erp.js"></script>
}

<div class="erp-ds erp-ds--fill cfg-item-page" id="cfg-item-page">
  <div class="page-head cfg-item-page__head">
    <div>
      <a href="/paltos/fertilizacion/configuracion-items" class="btn btn-sm" style="margin-bottom:10px"><i class="ri ri-arrow-left-line"></i>Volver a la lista</a>
      <h1 class="page-title">Configurar ítem</h1>
      <p class="page-sub">@(item?.CodigoItem ?? Model.Ite) · @(item?.NombreItem ?? "Sin nombre")</p>
    </div>
  </div>

  @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
  {
    <div class="note note-danger cfg-item-page__alert">@Model.ErrorMessage</div>
  }

  <form class="panel cfg-item-page__form" id="form-item">
    <div class="panel-head">
      <span>Configurar ítem</span>
      <span class="pill @(comun ? "" : (item?.TieneConfiguracion == true ? "pill-success" : "pill-danger"))">
        @(comun ? "Consumo común" : (item?.TieneConfiguracion == true ? "Nutriente" : "Pendiente"))
      </span>
    </div>
    <div class="panel-body">
      <div class="card muted" style="flex-direction:row;gap:12px;padding:10px 12px">
        <div style="flex:1;min-width:0">
          <span class="dt-code">@(item?.CodigoItem ?? Model.Ite)</span>
          <span class="dt-desc">@(item?.NombreItem ?? "—")</span>
        </div>
        <div style="padding-left:12px;border-left:1px solid var(--border)">
          <span class="stat-label" style="font-size:11px">Unidad</span>
          <b style="font-size:13px;color:var(--text)">@(item?.UnidadSalida ?? "—")</b>
        </div>
      </div>

      <div class="segmented">
        <input type="radio" id="modo-nut" name="modo" value="nutriente" @(comun ? null : "checked") />
        <label for="modo-nut"><i class="ri ri-leaf-line"></i>Nutriente</label>
        <input type="radio" id="modo-com" name="modo" value="comun" @(comun ? "checked" : null) />
        <label for="modo-com"><i class="ri ri-shopping-cart-2-line"></i>Consumo común</label>
      </div>

      <div class="card hint-text" data-si-modo="comun" hidden>El ítem se registra como consumo común. No aporta nutrientes al cálculo de fertilización y no requiere composición ni ficha técnica.</div>

      <div data-si-modo="nutriente" style="display:contents">
        <div class="card">
          <div class="step-head"><span class="step-num">1</span>Presentación</div>
          <p class="hint-text">La unidad de almacén (@(item?.UnidadSalida ?? "—")) no define si el producto es sólido o líquido: tú lo eliges.</p>
          <div class="segmented">
            <input type="radio" id="pres-sol" name="pres" value="solido" @(liquido ? null : "checked") />
            <label for="pres-sol">Sólido</label>
            <input type="radio" id="pres-liq" name="pres" value="liquido" @(liquido ? "checked" : null) />
            <label for="pres-liq">Líquido</label>
          </div>
          <p class="hint-text" data-si-pres="liquido" hidden>Unidad de salida @(item?.UnidadSalida): 1 unidad = 1 L de producto.</p>
          <p class="hint-text" data-si-pres="solido">Unidad de salida @(item?.UnidadSalida): el aporte se calcula por kg con % p/p.</p>
        </div>

        <div class="card">
          <div class="step-head"><span class="step-num">2</span>Composición nutricional</div>
          <p class="hint-text">Copia el valor del <strong>elemento puro</strong> de la ficha. Si la etiqueta dice óxido, conviértelo antes.</p>
          <button type="button" class="btn btn-help btn-sm" style="align-self:flex-start" data-modal-open="dlg-oxidos"><i class="ri ri-question-line"></i>Ayuda si la ficha tiene óxidos</button>
          <div class="empty" data-nut-vacio @(item?.Elementos?.Count > 0 ? "hidden" : null)>Aún no se configuró composición. Agrega el primer elemento desde la etiqueta o ficha técnica.</div>
          <div data-nut-lista style="display:flex;flex-direction:column;gap:6px">
            @foreach (var el in item?.Elementos ?? [])
            {
              <div data-nut-fila style="display:flex;align-items:center;gap:6px">
                <select class="input sm" style="width:78px" data-campo="Elemento" aria-label="Elemento">
                  @foreach (var e in elementosFijos)
                  {
                    <option value="@e" selected="@(e == el.ElementoCodigo)">@e</option>
                  }
                </select>
                <input class="input sm" style="flex:1" type="number" min="0" max="2000" step="0.1" placeholder="0.0" data-campo="Valor" value="@el.ValorDeclarado" aria-label="Valor" />
                <span data-nut-unidad style="width:44px;font-size:12px;color:var(--muted)">@(liquido ? "% p/v" : "% p/p")</span>
                <button type="button" class="icon-btn" data-nut-quitar aria-label="Quitar nutriente"><i class="ri ri-close-line"></i></button>
              </div>
            }
          </div>
          <button type="button" class="btn btn-outline btn-sm" style="align-self:flex-start" data-nut-agregar><i class="ri ri-add-line"></i>Agregar nutriente</button>
        </div>

        <div class="card muted" style="gap:6px">
          <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
            <b style="font-size:12.5px">1 <span data-unidad-palabra>@(liquido ? "litro" : "kg")</span> → aportes elementales</b>
            <span class="pill" data-aporte-vacio>Sin aporte calculable</span>
          </div>
          <div class="chips" data-aporte-chips></div>
          <span class="hint-text" data-aporte-ref style="font-variant-numeric:tabular-nums"></span>
        </div>

        <div class="card">
          <div class="step-head"><span class="step-num">3</span>Fuente y ficha técnica</div>
          <div class="field">
            <input class="input" id="fuente" placeholder="Fuente de la composición" value="@item?.FuenteComposicion" />
            <span class="field-help">Ejemplo: etiqueta del proveedor, ficha técnica o certificado de análisis.</span>
          </div>
        </div>
      </div>
    </div>
    <div class="panel-foot">
      <button type="button" class="btn btn-primary btn-lg" style="flex:1" id="btnGuardar"><i class="ri ri-save-3-line"></i>Guardar configuración</button>
    </div>
  </form>

  <template id="tpl-nutriente">
    <div data-nut-fila style="display:flex;align-items:center;gap:6px">
      <select class="input sm" style="width:78px" data-campo="Elemento" aria-label="Elemento">
        @foreach (var e in elementosFijos) { <option value="@e">@e</option> }
      </select>
      <input class="input sm" style="flex:1" type="number" min="0" max="2000" step="0.1" placeholder="0.0" data-campo="Valor" aria-label="Valor" />
      <span data-nut-unidad style="width:44px;font-size:12px;color:var(--muted)">% p/p</span>
      <button type="button" class="icon-btn" data-nut-quitar aria-label="Quitar nutriente"><i class="ri ri-close-line"></i></button>
    </div>
  </template>

  <dialog class="modal" id="dlg-oxidos" aria-labelledby="dlg-oxidos-t">
    <div class="modal-head"><i class="ri ri-question-line"></i><span class="modal-title" id="dlg-oxidos-t">Fichas con óxidos</span><button type="button" class="icon-btn" data-modal-close aria-label="Cerrar"><i class="ri ri-close-line" style="font-size:17px"></i></button></div>
    <div class="modal-body">
      <p>Si la etiqueta expresa el contenido como óxido, multiplica el valor por el factor para obtener el elemento puro.</p>
      <div class="note">Ejemplo: 46 % K₂O × 0.830 = 38.2 % K</div>
    </div>
    <div class="modal-foot"><button type="button" class="btn" data-modal-close>Entendido</button></div>
  </dialog>
</div>

@section PageScripts {
<script>
(function () {
  const form = document.getElementById('form-item');
  if (!form) return;
  const q = s => form.querySelector(s);
  const qa = s => [...form.querySelectorAll(s)];

  function sync() {
    const modo = q('[name="modo"]:checked')?.value || 'nutriente';
    const pres = q('[name="pres"]:checked')?.value || 'solido';
    const liq = pres === 'liquido';
    qa('[data-si-modo]').forEach(e => { e.hidden = e.dataset.siModo !== modo; });
    qa('[data-si-pres]').forEach(e => { e.hidden = e.dataset.siPres !== pres; });
    qa('[data-nut-unidad]').forEach(e => { e.textContent = liq ? '% p/v' : '% p/p'; });
    const palabra = q('[data-unidad-palabra]');
    if (palabra) palabra.textContent = liq ? 'litro' : 'kg';
    const filas = qa('[data-nut-fila]');
    const vacio = q('[data-nut-vacio]');
    if (vacio) vacio.hidden = filas.length > 0;
    const fmt = g => g >= 1000 ? (g / 1000).toFixed(2) + ' kg' : (Math.round(g * 10) / 10) + ' g';
    const val = filas.map(f => ({ el: f.querySelector('[data-campo=Elemento]')?.value, v: parseFloat(f.querySelector('[data-campo=Valor]')?.value) })).filter(x => x.v > 0);
    q('[data-aporte-chips]').innerHTML = val.map(x => `<span class="pill pill-success">${x.el} ${fmt(x.v * 10)}</span>`).join('');
    q('[data-aporte-vacio]').hidden = val.length > 0;
    q('[data-aporte-ref]').textContent = '20 ' + (liq ? 'litros' : 'kg') + ' → ' + (val.length ? val.map(x => x.el + ' ' + fmt(x.v * 200)).join(' · ') : 'aporte pendiente');
  }

  form.addEventListener('change', sync);
  form.addEventListener('input', sync);
  form.addEventListener('click', e => {
    if (e.target.closest('[data-nut-agregar]')) {
      q('[data-nut-lista]').appendChild(document.getElementById('tpl-nutriente').content.firstElementChild.cloneNode(true));
      sync();
    }
    const del = e.target.closest('[data-nut-quitar]');
    if (del) { del.closest('[data-nut-fila]').remove(); sync(); }
  });

  document.getElementById('btnGuardar').addEventListener('click', async () => {
    const modo = q('[name="modo"]:checked')?.value || 'nutriente';
    const liquido = q('[name="pres"]:checked')?.value === 'liquido';
    const elementos = qa('[data-nut-fila]').map(f => ({
      elementoCodigo: f.querySelector('[data-campo=Elemento]')?.value || '',
      formaDeclarada: '',
      valorDeclarado: Number(f.querySelector('[data-campo=Valor]')?.value || 0),
      tipoConcentracion: liquido ? 'PV' : 'PP'
    })).filter(x => x.elementoCodigo && x.valorDeclarado > 0);

    const res = await erp.post('?handler=Guardar', {
      clasificacion: modo === 'comun' ? 'AUXILIAR' : 'NUTRICIONAL',
      destinoReporte: modo === 'comun' ? 'CONSUMO' : 'NUTRIENTES',
      estadoValidacion: 'VALIDADO',
      formaFisica: liquido ? 'LIQUIDO' : 'SOLIDO',
      factorKgPorUnidad: liquido ? null : 1,
      factorLitrosPorUnidad: liquido ? 1 : null,
      vigenciaDesde: new Date().toISOString().slice(0, 10),
      fuenteComposicion: document.getElementById('fuente')?.value || '',
      activo: true,
      elementos: modo === 'comun' ? [] : elementos
    });
    erp.toast(res?.success ? 'success' : 'error', res?.message || (res?.success ? 'Guardado' : 'Error'));
  });

  sync();
})();
</script>
}
