@page "/paltos/fertilizacion/configuracion-items/{codigo}"
@model ErpAndahuasi.Pages.Paltos.Fertilizacion.ConfiguracionItems.ItemModel
@{
  ViewData["Title"] = Model.Item?.NombreItem ?? "Ítem";
  var item = Model.Item;
}
@section VendorScripts {
  <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
  <script src="~/js/erp.js"></script>
}
<a href="/paltos/fertilizacion/configuracion-items" class="btn btn-text-secondary mb-3"><i class="ri ri-arrow-left-line"></i> Volver</a>
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="alert alert-danger">@Model.ErrorMessage</div> }
@if (item is null) { <div class="alert alert-warning">No hay configuración para este ítem. Complete el formulario para crearla.</div> }
<div class="card">
  <div class="card-body">
    <h5 class="mb-4">@(item?.NombreItem ?? Model.Ite) <small class="text-muted">@Model.Grp-@Model.Cls-@Model.Ite</small></h5>
    <div class="row g-3">
      <div class="col-md-3">
        <label class="form-label">Clasificación</label>
        <select class="form-select" id="clasificacion">
          @foreach (var v in new[] { "NUTRICIONAL", "FITOSANITARIO", "BIOLOGICO", "AUXILIAR" })
          {
            <option selected="@(item?.Clasificacion == v)">@v</option>
          }
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label">Destino reporte</label>
        <select class="form-select" id="destinoReporte">
          @foreach (var v in new[] { "NUTRIENTES", "CONSUMO" }) { <option selected="@(item?.DestinoReporte == v)">@v</option> }
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label">Estado</label>
        <select class="form-select" id="estadoValidacion">
          @foreach (var v in new[] { "BORRADOR", "VALIDADO" }) { <option selected="@(item?.EstadoValidacion == v)">@v</option> }
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label">Forma física</label>
        <select class="form-select" id="formaFisica">
          @foreach (var v in new[] { "SOLIDO", "LIQUIDO" }) { <option selected="@(item?.FormaFisica == v)">@v</option> }
        </select>
      </div>
      <div class="col-md-3"><label class="form-label">kg / unidad</label><input type="number" step="0.0001" class="form-control" id="factorKg" value="@item?.FactorKgPorUnidad" /></div>
      <div class="col-md-3"><label class="form-label">L / unidad</label><input type="number" step="0.0001" class="form-control" id="factorLt" value="@item?.FactorLitrosPorUnidad" /></div>
      <div class="col-md-3"><label class="form-label">Densidad kg/L</label><input type="number" step="0.0001" class="form-control" id="densidad" value="@item?.DensidadKgPorLitro" /></div>
      <div class="col-md-3"><label class="form-label">Vigencia desde</label><input type="date" class="form-control" id="vigenciaDesde" value="@item?.VigenciaDesde?.ToString("yyyy-MM-dd")" /></div>
      <div class="col-md-12"><label class="form-label">Fuente de composición</label><input class="form-control" id="fuente" value="@item?.FuenteComposicion" /></div>
      <div class="col-12 form-check form-switch"><input class="form-check-input" type="checkbox" id="activo" checked="@(item?.Activo != false)" /><label class="form-check-label" for="activo">Activo</label></div>
    </div>
    <hr />
    <h6>Elementos</h6>
    <table class="table" id="tablaElem">
      <thead><tr><th>Elemento</th><th>Forma</th><th>Valor</th><th>Tipo</th><th></th></tr></thead>
      <tbody>
      @foreach (var el in item?.Elementos ?? [])
      {
        <tr>
          <td><input class="form-control form-control-sm codigo" value="@el.ElementoCodigo" list="elementosLista" /></td>
          <td><input class="form-control form-control-sm forma" value="@el.FormaDeclarada" /></td>
          <td><input type="number" step="0.0001" class="form-control form-control-sm valor" value="@el.ValorDeclarado" /></td>
          <td>
            <select class="form-select form-select-sm tipo">
              @foreach (var t in new[] { "PP", "PV", "GL" }) { <option selected="@(el.TipoConcentracion == t)">@t</option> }
            </select>
          </td>
          <td><button type="button" class="btn btn-sm btn-text-danger quitar">&times;</button></td>
        </tr>
      }
      </tbody>
    </table>
    <datalist id="elementosLista">
      @foreach (var el in Model.Elementos) { <option value="@el.Codigo">@el.Nombre</option> }
    </datalist>
    <button class="btn btn-sm btn-outline-secondary mb-4" id="btnAddElem" type="button">Agregar elemento</button>
    <div class="d-flex gap-2">
      <button class="btn btn-primary" id="btnGuardar" type="button">Guardar configuración</button>
    </div>
    <hr />
    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label">Imagen</label>
        <input type="file" class="form-control" id="imagen" accept="image/*" />
        <button class="btn btn-outline-primary mt-2" id="btnImagen" type="button">Subir imagen</button>
      </div>
      <div class="col-md-6">
        <label class="form-label">Documento (PDF)</label>
        <input type="file" class="form-control" id="documento" accept="application/pdf" />
        <input type="date" class="form-control mt-2" id="docVigencia" />
        <button class="btn btn-outline-primary mt-2" id="btnDocumento" type="button">Subir documento</button>
      </div>
    </div>
  </div>
</div>
@section PageScripts {
<script>
  $('#btnAddElem').on('click', () => {
    $('#tablaElem tbody').append(`<tr>
      <td><input class="form-control form-control-sm codigo" list="elementosLista" /></td>
      <td><input class="form-control form-control-sm forma" /></td>
      <td><input type="number" step="0.0001" class="form-control form-control-sm valor" /></td>
      <td><select class="form-select form-select-sm tipo"><option>PP</option><option>PV</option><option>GL</option></select></td>
      <td><button type="button" class="btn btn-sm btn-text-danger quitar">&times;</button></td></tr>`);
  });
  $('#tablaElem').on('click', '.quitar', function () { $(this).closest('tr').remove(); });
  $('#btnGuardar').on('click', async () => {
    const elementos = [];
    $('#tablaElem tbody tr').each(function () {
      const codigo = $(this).find('.codigo').val();
      if (!codigo) return;
      elementos.push({ elementoCodigo: codigo, formaDeclarada: $(this).find('.forma').val(), valorDeclarado: Number($(this).find('.valor').val()||0), tipoConcentracion: $(this).find('.tipo').val() });
    });
    const res = await erp.post('?handler=Guardar', {
      clasificacion: $('#clasificacion').val(), destinoReporte: $('#destinoReporte').val(), estadoValidacion: $('#estadoValidacion').val(),
      formaFisica: $('#formaFisica').val(), factorKgPorUnidad: $('#factorKg').val() ? Number($('#factorKg').val()) : null,
      factorLitrosPorUnidad: $('#factorLt').val() ? Number($('#factorLt').val()) : null,
      densidadKgPorLitro: $('#densidad').val() ? Number($('#densidad').val()) : null,
      vigenciaDesde: $('#vigenciaDesde').val() || new Date().toISOString().slice(0,10),
      fuenteComposicion: $('#fuente').val(), activo: $('#activo').is(':checked'), elementos
    });
    erp.toast(res.success ? 'success' : 'error', res.message || 'Guardado');
  });
  $('#btnImagen').on('click', async () => {
    const file = $('#imagen')[0].files[0];
    if (!file) return;
    const fd = new FormData(); fd.append('archivo', file);
    const res = await erp.post('?handler=Imagen', fd);
    erp.toast(res.success ? 'success' : 'error', res.message || 'Imagen cargada');
  });
  $('#btnDocumento').on('click', async () => {
    const file = $('#documento')[0].files[0];
    if (!file) return;
    const fd = new FormData(); fd.append('archivo', file); fd.append('vigenciaDesde', $('#docVigencia').val() || new Date().toISOString().slice(0,10)); fd.append('tipoDocumento', 'FT');
    const res = await erp.post('?handler=Documento', fd);
    erp.toast(res.success ? 'success' : 'error', res.message || 'Documento cargado');
  });
</script>
}
