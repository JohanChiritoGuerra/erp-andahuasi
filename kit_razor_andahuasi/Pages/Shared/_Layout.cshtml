@using Andahuasi.Models
@using Andahuasi.Services
@inject IShellService Shell
@{
    // Tema y estado del sidebar vienen de cookies para que el servidor pinte bien desde el primer momento.
    var tema = Context.Request.Cookies["tema"] == "dark" ? "dark" : "light";
    var sidebar = Context.Request.Cookies["sidebar"]; // "expanded" | "rail" | null (automático por ancho)
    var usuario = await Shell.GetUsuarioAsync(User);
    var notificaciones = await Shell.GetNotificacionesAsync(User);
    var hayNoLeidas = notificaciones.Any(n => !n.Leida);
}
<!DOCTYPE html>
<html lang="es" data-theme="@tema" data-sidebar="@sidebar">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Andahuasi</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/andahuasi.css" asp-append-version="true" />
    <script>
        // Sin preferencia guardada: expandido en >=1280px, rail por debajo. Evita el salto al cargar.
        (function (h) { if (!h.dataset.sidebar) h.dataset.sidebar = innerWidth >= 1280 ? 'expanded' : 'rail'; })(document.documentElement);
    </script>
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
<div class="app">
    <div class="scrim" data-drawer-close></div>

    <aside class="sidebar" aria-label="Navegación principal">
        <div class="sb-brand">
            <a href="/" class="logo" aria-label="Andahuasi, inicio"></a>
            <button type="button" class="icon-btn" data-sidebar-toggle aria-label="Contraer o expandir menú"><i class="ri-layout-left-line"></i></button>
        </div>

        <div class="sb-search">
            <label class="search">
                <i class="ri-search-line"></i>
                <input type="search" placeholder="Buscar accesos..." data-nav-search aria-label="Buscar accesos" />
                <button type="button" class="search-clear" data-search-clear aria-label="Borrar búsqueda" hidden><i class="ri-close-line"></i></button>
            </label>
            <button type="button" class="icon-btn bordered" data-nav-expand-all aria-label="Expandir o contraer todo"><i class="ri-expand-up-down-line"></i></button>
            <button type="button" class="icon-btn bordered sb-search-rail" data-flyout-all aria-label="Buscar accesos"><i class="ri-search-line"></i></button>
        </div>

        <nav class="sb-nav">
            @await Component.InvokeAsync("Menu")
        </nav>

        <div class="sb-footer">
            <button type="button" class="avatar" data-popover="pop-cuenta" data-placement="account" aria-label="Cuenta" aria-expanded="false">
                @if (!string.IsNullOrEmpty(usuario.FotoUrl)) { <img src="@usuario.FotoUrl" alt="" /> } else { <i class="ri-user-line" style="font-size:17px"></i> }
                <span class="online"></span>
            </button>
            <span class="sb-user"><b>@usuario.Nombre</b><small>@usuario.Cargo</small></span>
            <button type="button" class="icon-btn has-dot" data-popover="pop-notif" data-placement="right-end" aria-label="Notificaciones" aria-expanded="false">
                <i class="ri-notification-3-line"></i>@if (hayNoLeidas) { <span class="dot"></span> }
            </button>
        </div>
    </aside>

    <div class="main-col">
        <header class="mobile-header">
            <button type="button" class="icon-btn bordered" data-drawer-open aria-label="Abrir menú"><i class="ri-menu-line" style="font-size:18px"></i></button>
            <a href="/" class="logo" aria-label="Andahuasi, inicio"></a>
            <button type="button" class="icon-btn has-dot" data-popover="pop-notif" data-placement="bottom-end" aria-label="Notificaciones" aria-expanded="false">
                <i class="ri-notification-3-line"></i>@if (hayNoLeidas) { <span class="dot"></span> }
            </button>
            <button type="button" class="avatar" style="width:32px;height:32px" data-popover="pop-cuenta" data-placement="bottom-end" aria-label="Cuenta" aria-expanded="false">
                @if (!string.IsNullOrEmpty(usuario.FotoUrl)) { <img src="@usuario.FotoUrl" alt="" /> } else { <i class="ri-user-line" style="font-size:17px"></i> }
                <span class="online"></span>
            </button>
        </header>

        <main class="content">
            <div class="container @(ViewData["FillHeight"] is true ? "fill" : "")">
                @RenderBody()
            </div>
        </main>
    </div>
</div>

<!-- Popover: cuenta -->
<div class="popover" id="pop-cuenta" role="menu" hidden>
    <a class="menu-item" href="/Cuenta/Perfil"><i class="ri-user-line"></i>Ver mi perfil</a>
    <button type="button" class="menu-item @(tema == "light" ? "is-selected" : "")" data-theme-set="light"><i class="ri-sun-line"></i>Modo claro</button>
    <button type="button" class="menu-item @(tema == "dark" ? "is-selected" : "")" data-theme-set="dark"><i class="ri-moon-line"></i>Modo oscuro</button>
    <div class="menu-sep"></div>
    <form method="post" action="/Cuenta/Salir">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger btn-block" style="height:34px">Cerrar sesión <i class="ri-logout-box-r-line"></i></button>
    </form>
</div>

<!-- Popover: notificaciones -->
<div class="popover wide" id="pop-notif" hidden>
    <div class="pop-head">
        <span class="pop-title">Notificaciones</span>
        <form method="post" action="/Notificaciones/MarcarLeidas">@Html.AntiForgeryToken()<button type="submit" class="btn-ghost" style="border:0;background:none;padding:0;font-size:12px;font-weight:500;color:var(--accent-text);cursor:pointer">Marcar leídas</button></form>
    </div>
    <div class="pop-body">
        @if (!notificaciones.Any()) { <div class="dt-empty">No tienes notificaciones.</div> }
        @foreach (var n in notificaciones)
        {
            <a class="notif @(n.Leida ? "" : "unread")" href="@n.Url">
                <span class="mark"></span>
                <span><b>@n.Titulo</b><small>@n.Modulo · @n.Hace</small></span>
            </a>
        }
    </div>
    <a class="pop-foot" href="/Notificaciones">Ver todas</a>
</div>

<!-- Flyout del rail (lo llena shell.js) -->
<div class="flyout" id="nav-flyout" hidden>
    <div class="flyout-head">
        <span class="flyout-title"></span>
        <div class="flyout-tools">
            <label class="search sm">
                <i class="ri-search-line"></i>
                <input type="search" data-flyout-search aria-label="Buscar" />
                <button type="button" class="search-clear" data-search-clear aria-label="Borrar búsqueda" hidden><i class="ri-close-line"></i></button>
            </label>
            <button type="button" class="icon-btn bordered" style="width:30px;height:30px" data-flyout-expand-all aria-label="Expandir o contraer todo"><i class="ri-expand-up-down-line"></i></button>
        </div>
    </div>
    <div class="flyout-body"></div>
</div>

<script src="~/js/shell.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
